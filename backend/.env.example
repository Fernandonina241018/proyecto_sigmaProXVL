# ===========================================
# StatAnalyzer Pro — Backend Environment Variables
# ===========================================

# REQUIRED — JWT signing secret (minimum 32 characters)
JWT_SECRET=change-this-to-a-random-string-min-32-chars

# REQUIRED — Default admin password (used on first run to create admin user)
DEFAULT_USER_PASSWORD=change-this-password

# REQUIRED — PostgreSQL connection string (Supabase or local)
DATABASE_URL=postgresql://user:password@host:5432/database_name

# OPTIONAL — JWT expiration (default: 8h)
JWT_EXPIRES_IN=8h

# OPTIONAL — ML Service URL (default: http://localhost:8000)
ML_SERVICE_URL=http://localhost:8000

# OPTIONAL — ML API key (for proxy requests to ML service)
ML_API_KEY=

# OPTIONAL — Comma-separated allowed origins for CORS
# If empty, uses the project's default origins (GitHub Pages + localhost dev)
CORS_ORIGINS=

# REQUIRED — Initial admin username (used on first run)
ADMIN_USERNAME=admin

# REQUIRED — Initial admin password (used on first run)
ADMIN_PASSWORD=change-this-password
