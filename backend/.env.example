# ===========================================
# StatAnalyzer Pro — Backend Environment Variables
# Copiar a backend/.env y completar los REQUIRED.
# Verificación: cada clave aquí se usa en backend/server.js o
# backend/database.js (OPT-7: sin claves muertas ni faltantes).
# ===========================================

# REQUIRED — JWT signing secret (mínimo 32 caracteres)
# Uso: server.js (firma/verificación de tokens)
JWT_SECRET=change-this-to-a-random-string-min-32-chars

# REQUIRED — PostgreSQL connection string (Supabase o local)
# Uso: database.js (elige impl PG vs store JSON local).
# Sin DATABASE_URL el backend usa store JSON local (solo dev).
DATABASE_URL=postgresql://user:password@host:5432/database_name

# REQUIRED — Admin inicial (creado en primer arranque si no existe)
# Uso: database.js (createInitialAdmin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# OPTIONAL — JWT expiration (default: 8h)
# Uso: server.js (login, /api/me, 2FA)
JWT_EXPIRES_IN=8h

# OPTIONAL — Puerto del backend (default: 3000)
# Uso: server.js
PORT=3000

# OPTIONAL — URL del ML Service para el proxy /api/ml/* (default: http://localhost:8000)
# Uso: server.js. En Fly.io: https://sigmapro-ml.fly.dev
ML_SERVICE_URL=http://localhost:8000

# OPTIONAL — Devuelve esta clave vía GET /api/ml-api-key (solo admin).
# OJO: el proxy /api/ml/* NO la reenvía al ML Service. Si el ML Service
# tiene API_KEY configurada, el proxy recibirá 401. Mantén API_KEY sin
# definir en ml_service salvo que el proxy la inyecte (pendiente).
# Uso: server.js
ML_API_KEY=

# OPTIONAL — Orígenes CORS separados por comas.
# Si vacío, usa los defaults del proyecto (GitHub Pages + localhost).
# Uso: server.js
CORS_ORIGINS=

# OPTIONAL — Desactiva verificación SSL de Postgres (solo dev local).
# Uso: database.js. Supabase/Fly REQUIEREN SSL: no definir en prod.
DB_SSL_INSECURE=

# LEGACY — Ya NO se usa para crear usuarios (se generan passwords
# aleatorios con crypto). Solo evita el warning de arranque.
# Uso: server.js (warning si ausente). Se eliminará en v2.
DEFAULT_USER_PASSWORD=change-this-password

# OPTIONAL — Retención de bandeja de firmas en días (default: 182).
# Las complete más viejas se purgan vía POST /api/admin/purge.
RETENTION_DAYS=182

# OPTIONAL — Retención de rechazadas en días (default: 90).
REJECTED_DAYS=90

# OPTIONAL — Notificaciones por publicación (solo título+firmante, opt-in).
# Usa Mailtrap (sandbox en dev con MAILTRAP_INBOX_ID, producción con dominio verificado).
# Ver backend/notifications/mailtrap.js
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=
MAIL_FROM_EMAIL=noreply@sigmaproxvl.fly.dev
MAIL_FROM_NAME=SigmaProXVL
FRONTEND_URL=https://fernandonina241018.github.io/proyecto_sigmaProXVL
