# ===========================================
# StatAnalyzer Pro — ML Service Environment Variables
# Copiar a ml_service/.env y completar según entorno.
# Verificación: cada clave se usa en ml_service/main.py.
# ===========================================

# OPTIONAL — Puerto del ML Service (default: 8000).
# Uso: main.py. OJO: en Fly.io el Dockerfile fija --port 8080 y
# fly.toml internal_port 8080; en local start-all.sh usa 8000.
# No definir PORT en local salvo que alinees ambas puntas.
PORT=8000

# OPTIONAL — Auth opt-in del ML Service (default: sin auth).
# Uso: main.py (exige X-API-Key salvo /health y /docs).
# ADVERTENCIA: el proxy del backend (/api/ml/*) NO reenvía X-API-Key,
# así que definir API_KEY rompe el proxy. Déjalo vacío hasta que el
# proxy la inyecte (pendiente, ver backend/.env.example ML_API_KEY).
API_KEY=

# FIJA — Backend Agg para matplotlib sin display (la define start-all.sh).
# Uso: main.py.
MPLBACKEND=Agg
